{
  "name": "pfm-viewer",
  "displayName": "PFM Viewer",
  "description": "Viewer for PFM (Pure Fucking Magic) AI agent output files",
  "version": "0.1.0",
  "publisher": "pfm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:pfm"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pfm",
        "aliases": [
          "PFM",
          "Pure Fucking Magic"
        ],
        "extensions": [
          ".pfm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pfm",
        "scopeName": "source.pfm",
        "path": "./syntaxes/pfm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pfm.openPreview",
        "title": "PFM: Open Preview",
        "icon": "$(preview)"
      },
      {
        "command": "pfm.validateChecksum",
        "title": "PFM: Validate Checksum"
      },
      {
        "command": "pfm.goToSection",
        "title": "PFM: Go to Section"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == pfm",
          "command": "pfm.openPreview",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pfm.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == pfm"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.0.0"
  },
  "overrides": {
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^5": "^5.0.12",
    "fast-uri@^3": "^3.1.9",
    "form-data@^4": "^4.0.6",
    "js-yaml@^4": "^4.3.2",
    "linkify-it@^5": "^5.0.2",
    "lodash@^4": "^4.18.0",
    "markdown-it@^14": "^14.3.3",
    "minimatch@^3": "^11.0.1",
    "minimatch@^10": "^11.0.1",
    "picomatch@^2": "^2.3.2",
    "tmp@^0.2": "^0.2.6",
    "underscore@^1": "^1.13.8",
    "undici@^7": "^7.30.1",
    "glob@^11": "^14.0.2",
    "qs@^6": "^6.16.1",
    "uuid@^8": "^11.1.1"
  }
}
